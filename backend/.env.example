NODE_ENV=production
PORT=5000
FRONTEND_URL=https://printhubdesi.vercel.app
JWT_SECRET=replace-with-a-strong-secret
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSLMODE=require
PUBLIC_BACKEND_URL=https://printease-backend-byex.onrender.com
AGENT_TOKEN_SECRET=replace-with-a-long-random-agent-secret
AGENT_PAIRING_TTL_SECONDS=60
AGENT_APPROVAL_TTL_SECONDS=60
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=documents
# Only manual counter/centre-UPI payment is supported; no gateway keys needed.
ALLOW_VERCEL_PREVIEW_ORIGINS=false
# Exact origins only when the opt-in above is enabled.
VERCEL_PREVIEW_ORIGINS=
ALLOW_LOCAL_ORIGINS=false
ALLOW_DESKTOP_NULL_ORIGIN=false
GLOBAL_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MINUTES=20
# Per-process memory budgets. Customer and converted-PDF delivery are separate.
MAX_CONCURRENT_UPLOADS=1
MAX_CONCURRENT_AGENT_UPLOADS=1
# Configure a separate random secret only when using the cleanup HTTP endpoint.
SYSTEM_CRON_SECRET=
